{
  "name": "frontend-api-extractor",
  "version": "0.9.0",
  "private": true,
  "type": "module",
  "bin": {
    "frontend-api-extractor": "src/cli.js",
    "frontend-api-repository": "src/repository-cli.js",
    "frontend-api-scripts": "src/scripts-cli.js",
    "frontend-api-delivery": "src/delivery-cli.js",
    "frontend-api-ai": "src/ai-cli.js",
    "frontend-api-server": "src/server-cli.js"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "scan": "node src/cli.js",
    "demo": "node src/cli.js examples/multi-framework --out reports/multi-framework.json",
    "scan:repository": "node src/repository-cli.js",
    "verify:baseline": "node src/baseline-cli.js",
    "compare:requests": "node src/compare-cli.js",
    "verify:external": "node src/external-baseline-cli.js",
    "scan:scripts": "node src/scripts-cli.js",
    "delivery": "node src/delivery-cli.js",
    "annotate:fields": "node src/ai-cli.js",
    "serve": "node src/server-cli.js",
    "benchmark": "node src/benchmark-cli.js"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@jridgewell/trace-mapping": "^0.3.31",
    "@vue/compiler-sfc": "^3.5.0",
    "fast-glob": "^3.3.3",
    "parse5": "7.3.0",
    "picomatch": "^4.0.0",
    "svelte": "^5.0.0",
    "typescript": "^5.9.0",
    "undici": "7.30.1"
  }
}
