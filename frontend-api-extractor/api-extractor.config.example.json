{
  "entries": ["src/pages/**", "src/views/**", "src/routes/**"],
  "maxDepth": 8,
  "maxSteps": 100000,
  "maxStepsPerFile": null,
  "maxCandidates": 16,
  "aliases": { "@/*": ["src/*"] },
  "layers": [
    { "name": "page", "match": ["src/pages/**", "src/views/**", "src/routes/**"] },
    { "name": "service", "match": ["src/api/**", "src/services/**"] },
    { "name": "transport", "match": ["src/utils/request.*", "src/http/**"] }
  ],
  "clients": [{ "name": "this.http", "kind": "axios" }]
}
