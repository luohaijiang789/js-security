{
  "manifest_version": 3,
  "name": "JS 请求采集",
  "version": "0.5.3",
  "minimum_chrome_version": "125",
  "description": "浏览器全局采集网页请求与响应，按 Filter 留存并可自动转存到阿里云 SLS。",
  "permissions": [
    "debugger",
    "tabs",
    "storage",
    "unlimitedStorage",
    "downloads",
    "alarms"
  ],
  "optional_host_permissions": ["https://*/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "打开 JS 请求观察台"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
