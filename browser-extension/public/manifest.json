{
  "manifest_version": 3,
  "name": "API与JS采集",
  "version": "0.12.0",
  "minimum_chrome_version": "125",
  "description": "统一收集API、JS和上下文，未确认数据可恢复补传，由服务器核对并分析。",
  "permissions": [
    "debugger",
    "tabs",
    "storage",
    "unlimitedStorage",
    "downloads",
    "alarms"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "打开 JS 请求观察台"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
